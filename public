<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cairn — Messages</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font: 16px system-ui, sans-serif;
      color: #20251f;
      background: #f2f3ee;
    }
    main {
      width: min(680px, 100%);
      min-height: 100vh;
      margin: auto;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
    }
    h1 { margin: 0; }
    .subtitle { margin: 4px 0 20px; color: #62685e; }
    .panel, #chat {
      background: white;
      border: 1px solid #dfe2d9;
      border-radius: 14px;
      padding: 16px;
    }
    label { display: block; margin: 12px 0 5px; }
    input, button {
      width: 100%;
      padding: 12px;
      border: 1px solid #c9cec2;
      border-radius: 9px;
      font: inherit;
    }
    button {
      margin-top: 12px;
      border: 0;
      color: white;
      background: #385b43;
      font-weight: 600;
    }
    button:disabled { opacity: .55; }
    #chat { flex: 1; margin-top: 16px; min-height: 300px; }
    #status { color: #62685e; font-size: 14px; }
    #messages {
      height: min(52vh, 440px);
      overflow-y: auto;
      padding: 0;
      list-style: none;
    }
    #messages li { padding: 10px 0; border-bottom: 1px solid #eee; }
    .meta { color: #62685e; font-size: 13px; }
    #send-form { display: flex; gap: 8px; }
    #send-form input { flex: 1; }
    #send-form button { width: auto; margin: 0; }
    .warning { font-size: 13px; color: #62685e; }
  </style>
</head>
<body>
  <main>
    <h1>Cairn</h1>
    <p class="subtitle">A simple place to talk in real time.</p>

    <section class="panel" id="join-panel">
      <label for="name">Your display name</label>
      <input id="name" maxlength="24" placeholder="e.g. Alex" autocomplete="nickname">

      <label for="room">Room code</label>
      <input id="room" maxlength="40" placeholder="e.g. weekend-chat"
             autocomplete="off" autocapitalize="none">

      <button id="join-button">Join room</button>
      <p class="warning">Anyone who knows the room code can join. Don’t share sensitive information.</p>
    </section>

    <section id="chat" hidden>
      <p id="status">Connecting…</p>
      <ul id="messages" aria-live="polite"></ul>
      <form id="send-form">
        <input id="message-input" maxlength="1000" placeholder="Write a message"
               autocomplete="off" aria-label="Message">
        <button id="send-button">Send</button>
      </form>
    </section>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const joinPanel = document.querySelector("#join-panel");
    const chat = document.querySelector("#chat");
    const status = document.querySelector("#status");
    const messages = document.querySelector("#messages");
    const joinButton = document.querySelector("#join-button");
    const sendForm = document.querySelector("#send-form");
    const messageInput = document.querySelector("#message-input");

    let myName = "";

    function addMessage(name, text, time) {
      const item = document.createElement("li");
      const meta = document.createElement("div");
      const body = document.createElement("div");

      meta.className = "meta";
      meta.textContent = `${name} · ${new Date(time).toLocaleTimeString()}`;
      body.textContent = text;

      item.append(meta, body);
      messages.appendChild(item);
      messages.scrollTop = messages.scrollHeight;
    }

    joinButton.addEventListener("click", () => {
      myName = document.querySelector("#name").value.trim();
      const room = document.querySelector("#room").value.trim().toLowerCase();

      if (!myName || !/^[a-z0-9-]{3,40}$/.test(room)) {
        status.textContent = "Enter a name and a room code (3–40 letters, numbers, or hyphens).";
        return;
      }

      joinButton.disabled = true;
      status.textContent = "Connecting…";

      socket.emit("join-room", { room, name: myName });
      joinPanel.hidden = true;
      chat.hidden = false;
      status.textContent = `Room: ${room}`;
      messageInput.focus();
    });

    socket.on("connect", () => {
      joinButton.disabled = false;
    });

    socket.on("disconnect", () => {
      status.textContent = "Disconnected. Refresh the page to reconnect.";
    });

    socket.on("room-history", (history) => {
      messages.replaceChildren();
      history.forEach((message) =>
        addMessage(message.name, message.text, message.time)
      );
    });

    socket.on("message", (message) => {
      addMessage(message.name, message.text, message.time);
    });

    socket.on("notice", (text) => {
      const item = document.createElement("li");
      item.className = "meta";
      item.textContent = text;
      messages.appendChild(item);
    });

    sendForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const text = messageInput.value.trim();
      if (!text) return;

      socket.emit("send-message", text);
      messageInput.value = "";
      messageInput.focus();
    });
  </script>
</body>
</html>
